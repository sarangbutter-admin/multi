{
  "name": "Bold",
  "version": "1.0.0",
  "author": "TukuPack",
  "description": "Big type, thick outlines and solid colour blocks. A loud, modern shop with quick view on every card.",
  "settings": [
    { "type": "header", "label": "Colours and type" },
    { "id": "primary", "type": "color", "label": "Main colour", "default": "#FFDA1A" },
    { "id": "accent", "type": "color", "label": "Highlight", "default": "#0058A3" },
    { "id": "background", "type": "color", "label": "Background", "default": "#FFFFFF" },
    { "id": "surface", "type": "color", "label": "Cards", "default": "#FFFFFF" },
    { "id": "text", "type": "color", "label": "Text", "default": "#111111" },
    { "id": "font", "type": "font", "label": "Font", "default": "Space Grotesk" },
    { "id": "radius", "type": "range", "label": "Corner roundness", "min": 0, "max": 28, "step": 1, "default": 6 },
    { "id": "logo", "type": "image", "label": "Logo", "info": "Square image link (https://)", "default": "" },

    { "type": "header", "label": "Top strip" },
    { "id": "announcement", "type": "text", "label": "Message across the top", "info": "Leave empty to hide it", "default": "Order today. Pick up or delivery." },

    { "type": "header", "label": "Big banner" },
    { "id": "hero_title", "type": "text", "label": "Headline", "info": "Leave empty to show your store name", "default": "Fresh groceries, fast." },
    { "id": "hero_text", "type": "textarea", "label": "Text under the headline", "info": "Leave empty to show your store description", "default": "" },
    { "id": "hero_button", "type": "text", "label": "Button", "default": "Shop now" },
    { "id": "hero_image", "type": "image", "label": "Banner picture", "info": "A cut-out picture on a plain background works best", "default": "asset:hero.svg" },

    { "type": "header", "label": "Blue strip" },
    { "id": "perk_1", "type": "text", "label": "Point 1", "default": "Fresh every day" },
    { "id": "perk_2", "type": "text", "label": "Point 2", "default": "Pick up or delivery" },
    { "id": "perk_3", "type": "text", "label": "Point 3", "default": "QRIS, e-wallet or transfer" },

    { "type": "header", "label": "Band near the bottom" },
    { "id": "promo_title", "type": "text", "label": "Headline", "info": "Leave empty to hide the band", "default": "Ordering for a team?" },
    { "id": "promo_text", "type": "textarea", "label": "Text", "default": "Ask about a business account for better prices on regular orders." }
  ]
}
