SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # secret key – server only
SESSION_SECRET=                      # 32+ random chars
MASTER_KEY=                          # 32+ random chars – encrypts every store's API keys. Never change it after stores add keys.
SUPER_SETUP_KEY=                     # 12+ chars, used once to create your super-admin
PLATFORM_DOMAIN=sarangorder.com      # stores live at <slug>.sarangorder.com
PUBLIC_BASE_URL=https://sarangorder.com   # used to build webhook and payment-return URLs
APP_ORIGINS=capacitor://localhost,https://localhost   # the Android/iOS app shell
TURNSTILE_SECRET=                    # platform Turnstile secret (protects the sign-up page)
CRON_SECRET=                         # optional: protects POST /api/cron/sweep if you call it externally
